rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read: if true; // Public read for profiles
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Game stats collection
    match /gameStats/{userId} {
      allow read: if true; // Public read for leaderboards
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Ships collection
    match /ships/{shipId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // Tasks collection
    match /tasks/{taskId} {
      allow read: if resource.data.isActive == true;
      allow write: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // User tasks collection
    match /userTasks/{userTaskId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // Referral earnings collection
    match /referralEarnings/{earningId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.referrerId || 
         request.auth.uid == resource.data.referredId);
      allow create: if request.auth != null;
    }
  }
}