{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [
      "vite/client",
      "vite-plugin-svgr/client",
      "jest",
      "@testing-library/jest-dom"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": "src",
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noImplicitThis": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/App.tsx",
    "src/index.tsx",
    "src/initConfig.ts",
    "src/polyfills.ts",
    "src/setupTests.ts",
    "src/components/**/*",
    "src/context/ToastContext.tsx",
    "src/helpers/**/*",
    "src/hooks/**/*",
    "src/lib/**/*",
    "src/localConstants/**/*",
    "src/pages/Home/**/*",
    "src/pages/Builder/**/*",
    "src/pages/Preview/**/*",
    "src/pages/Disclaimer/**/*",
    "src/pages/PageNotFound/**/*",
    "src/pages/Unlock/**/*",
    "src/pages/index.ts",
    "src/provider/**/*",
    "src/routes/**/*",
    "src/styles/**/*",
    "src/types/**/*",
    "src/utils/**/*",
    "src/wrappers/**/*",
    "vite-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "src/context/AuthContext.tsx",
    "src/hooks/useGigViews.ts",
    "src/hooks/useNotifications.ts", 
    "src/hooks/useOrders.ts",
    "src/hooks/useProfile.ts",
    "src/hooks/useReviews.ts",
    "src/lib/supabase.ts",
    "src/pages/Admin/**/*",
    "src/pages/GigDetail/**/*",
    "src/pages/OrderDetails/**/*", 
    "src/pages/Profile/**/*",
    "src/pages/ProposalDetail/**/*",
    "src/pages/Gigs/**/*",
    "src/components/OrderChat.tsx",
    "src/components/ProposalChat.tsx",
    "src/components/AdminDisputes.tsx",
    "src/components/AdminUsers.tsx",
    "src/components/AdminGigs.tsx",
    "src/components/OrderRequirementsModal.tsx",
    "src/components/ReviewsList.tsx",
    "src/components/StarRating.tsx",
    "src/components/DisputeModal.tsx",
    "src/components/ReviewModal.tsx",
    "src/components/EmailNotificationsToggle.tsx"
  ]
}